<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SegurançaRe"
             x:Class="SegurançaRe.telausuario"
             Title="Painel de Segurança"
             BackgroundColor="#1E1E2E">

    <Grid RowDefinitions="Auto, *">

        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="20" BackgroundColor="#181825">
            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                <Label Text="Painel Administrativo" 
                       FontSize="22" 
                       FontAttributes="Bold" 
                       TextColor="#FFFFFF" />
                <Label Text="Gerenciamento de Residências e Moradores" 
                       FontSize="14" 
                       TextColor="#A6ADC8" />
            </VerticalStackLayout>

            <Button Grid.Column="1" 
                    Text="Sair" 
                    BackgroundColor="#F38BA8" 
                    TextColor="#11111B" 
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="40"
                    Clicked="BtnSair_Clicked" />
        </Grid>

        <ScrollView Grid.Row="1" Padding="20">
            <VerticalStackLayout Spacing="25">

                <Frame BackgroundColor="#313244" CornerRadius="12" Padding="15" HasShadow="True">
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                            <Label Text="📹 Câmera de Monitoramento IA" 
                                   FontSize="16" 
                                   FontAttributes="Bold" 
                                   TextColor="#CBA6F7" />
                            <Label Text="Inicie a simulação de visão computacional em tempo real (YOLOv8)" 
                                   FontSize="12" 
                                   TextColor="#A6ADC8" />
                        </VerticalStackLayout>

                        <Button Grid.Column="1" 
                                Text="Simular Câmera YOLO" 
                                BackgroundColor="#CBA6F7" 
                                TextColor="#11111B" 
                                FontAttributes="Bold" 
                                CornerRadius="8" 
                                HeightRequest="40" 
                                Clicked="BtnSimularCameraYolo_Clicked" />
                    </Grid>
                </Frame>

                <Grid ColumnDefinitions="*, Auto" BackgroundColor="#313244" Padding="15" Margin="0">
                    <HorizontalStackLayout Grid.Column="0" Spacing="15" VerticalOptions="Center">
                        <Label x:Name="LblTotalUsuarios" 
                               Text="00" 
                               FontSize="32" 
                               FontAttributes="Bold" 
                               TextColor="#89B4FA" 
                               VerticalOptions="Center" />
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Casas Cadastradas" 
                                   FontSize="16" 
                                   FontAttributes="Bold" 
                                   TextColor="#CDD6F4" />
                            <Label Text="Total de donos registrados no Firestore" 
                                   FontSize="12" 
                                   TextColor="#A6ADC8" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <Button Grid.Column="1" 
                            Text="Atualizar" 
                            BackgroundColor="#89B4FA" 
                            TextColor="#11111B" 
                            FontAttributes="Bold"
                            CornerRadius="8"
                            Clicked="BtnAtualizarDados_Clicked" />
                </Grid>

                <Frame BackgroundColor="#313244" CornerRadius="12" Padding="20" HasShadow="True">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="Cadastrar Novo Dono de Casa" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="#A6E3A1" />

                        <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, *" ColumnSpacing="10" RowSpacing="10">

                            <Entry x:Name="TxtNovoNome" 
                                   Grid.Row="0" Grid.Column="0" 
                                   Placeholder="Nome do Responsável" 
                                   PlaceholderColor="#6C7086" 
                                   TextColor="#CDD6F4" 
                                   BackgroundColor="#1E1E2E" />

                            <Entry x:Name="TxtNovoCpf" 
                                   Grid.Row="0" Grid.Column="1" 
                                   Placeholder="CPF (apenas números)" 
                                   PlaceholderColor="#6C7086" 
                                   TextColor="#CDD6F4" 
                                   Keyboard="Numeric" 
                                   BackgroundColor="#1E1E2E" />

                            <Entry x:Name="TxtNovoCodigoCasa" 
                                   Grid.Row="1" Grid.Column="0" 
                                   Placeholder="Código da Casa (ex: Casa_01)" 
                                   PlaceholderColor="#6C7086" 
                                   TextColor="#CDD6F4" 
                                   BackgroundColor="#1E1E2E" />

                            <Entry x:Name="TxtNovoCep" 
                                   Grid.Row="1" Grid.Column="1" 
                                   Placeholder="CEP (apenas números)" 
                                   PlaceholderColor="#6C7086" 
                                   TextColor="#CDD6F4" 
                                   Keyboard="Numeric" 
                                   BackgroundColor="#1E1E2E" />

                            <Entry x:Name="TxtNovoNumero" 
                                   Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                   Placeholder="Número / Complemento (ex: 68 ou Ap 12)" 
                                   PlaceholderColor="#6C7086" 
                                   TextColor="#CDD6F4" 
                                   BackgroundColor="#1E1E2E" />
                        </Grid>

                        <Button Text="Cadastrar Residência" 
                                BackgroundColor="#A6E3A1" 
                                TextColor="#11111B" 
                                FontAttributes="Bold" 
                                CornerRadius="8" 
                                HeightRequest="45"
                                Clicked="BtnNovoDono_Clicked" />
                    </VerticalStackLayout>
                </Frame>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Residências e Moradores Cadastrados" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           TextColor="#CDD6F4" />

                    <ListView x:Name="ListViewUsuarios" 
                              HasUnevenRows="True" 
                              SelectionMode="None" 
                              SeparatorVisibility="None"
                              BackgroundColor="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:DonoModel">
                                <ViewCell>
                                    <Frame BackgroundColor="#313244" 
                                           CornerRadius="10" 
                                           Margin="0,5" 
                                           Padding="15" 
                                           HasShadow="False">
                                        <VerticalStackLayout Spacing="10">

                                            <Grid ColumnDefinitions="*, Auto">
                                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                    <Label Text="{Binding Nome}" 
                                                           FontSize="16" 
                                                           FontAttributes="Bold" 
                                                           TextColor="#89B4FA" />
                                                    <Label Text="{Binding CpfFormatado}" 
                                                           FontSize="12" 
                                                           TextColor="#A6ADC8" />
                                                    <Label Text="{Binding DetalhesResidencia}" 
                                                           FontSize="12" 
                                                           TextColor="#A6ADC8" />
                                                </VerticalStackLayout>

                                                <Button Grid.Column="1" 
                                                        Text="Remover" 
                                                        BackgroundColor="#F38BA8" 
                                                        TextColor="#11111B" 
                                                        FontSize="12"
                                                        HeightRequest="35"
                                                        CornerRadius="6"
                                                        CommandParameter="{Binding Cpf}"
                                                        Clicked="BtnRemoverDono_Clicked" />
                                            </Grid>

                                            <BoxView HeightRequest="1" Color="#45475A" Margin="0,5" />

                                            <Grid ColumnDefinitions="*, Auto">
                                                <Label Grid.Column="0" 
                                                       Text="{Binding TotalMoradoresTexto}" 
                                                       FontSize="13" 
                                                       FontAttributes="Bold" 
                                                       TextColor="#FAB387" 
                                                       VerticalOptions="Center" />

                                                <Button Grid.Column="1" 
                                                        Text="+ Morador" 
                                                        BackgroundColor="#FAB387" 
                                                        TextColor="#11111B" 
                                                        FontSize="12"
                                                        HeightRequest="32"
                                                        CornerRadius="6"
                                                        CommandParameter="{Binding .}"
                                                        Clicked="BtnAdicionarMorador_Clicked" />
                                            </Grid>

                                            <StackLayout BindableLayout.ItemsSource="{Binding Moradores}" Spacing="5" Margin="10,5,0,0">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="local:MoradorModel">
                                                        <Grid ColumnDefinitions="*, Auto" Margin="0,2">

                                                            <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                                                <Label Text="•" TextColor="#A6E3A1" FontSize="14" VerticalOptions="Center" />
                                                                <Label Text="{Binding Nome}" TextColor="#CDD6F4" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                                                <Label Text="-" TextColor="#6C7086" FontSize="13" VerticalOptions="Center" />
                                                                <Label Text="{Binding Cpf}" TextColor="#A6ADC8" FontSize="12" VerticalOptions="Center" />
                                                            </HorizontalStackLayout>

                                                            <Button Grid.Column="1"
                                                                    Text="✕"
                                                                    BackgroundColor="#F38BA8"
                                                                    TextColor="#11111B"
                                                                    FontAttributes="Bold"
                                                                    FontSize="11"
                                                                    HeightRequest="24"
                                                                    WidthRequest="28"
                                                                    CornerRadius="4"
                                                                    Padding="0"
                                                                    CommandParameter="{Binding .}"
                                                                    Clicked="BtnRemoverMorador_Clicked" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </StackLayout>

                                        </VerticalStackLayout>
                                    </Frame>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>