<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SegurançaRe.CameraPage"
             Title="Monitoramento IA">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

            <Label Text="Sistema de Detecção YOLOv8"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label Text="Ao clicar no botão abaixo, uma nova janela será aberta com o fluxo de vídeo e a inteligência artificial em tempo real."
                   FontSize="14"
                   TextColor="Gray"
                   HorizontalTextAlignment="Center" />

            <Border BackgroundColor="#F5F5F5" Padding="15" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Instruções:" FontAttributes="Bold" />
                    <Label Text="• A janela do OpenCV será exibida na sua área de trabalho." />
                    <Label Text="• Para fechar a câmera, pressione a tecla 'Q' na janela do vídeo." />
                </VerticalStackLayout>
            </Border>

            <Button Text="Iniciar Câmera IA"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    Clicked="OnIniciarCameraClicked" />

            <Label x:Name="LblStatus"
                   Text=""
                   FontSize="12"
                   HorizontalOptions="Center"
                   TextColor="DimGray" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>