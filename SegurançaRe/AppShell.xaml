<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SegurançaRe.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SegurançaRe"
    Title="Security +">

    <ShellContent
        Title="Boas-Vindas"
        ContentTemplate="{DataTemplate local:bemvindo}"
        Route="WelcomePage" />

    <ShellContent
        Title="Cadastro"
        ContentTemplate="{DataTemplate local:Cadastro}"
        Route="CadastroPage" />

    <ShellContent
        Title="Painel"
        ContentTemplate="{DataTemplate local:telausuario}"
        Route="TelaUsuarioPage" />

</Shell>